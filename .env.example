# ResolverAI Environment Configuration
# Copy to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://resolver:resolver@localhost:5432/resolverai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI Mode ---
# Options: DETERMINISTIC, ENABLED
AI_MODE=DETERMINISTIC
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Razorpay Integration ---
# Options: TEST, LIVE
RAZORPAY_MODE=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- JWT Authentication ---
JWT_SECRET_KEY=resolverai_production_jwt_secret_key_change_me
JWT_EXPIRE_SECONDS=86400
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=admin123

# --- System ---
ENVIRONMENT=development
MAX_RETRIES=3
CHAOS_SEED=42
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WEBHOOK_MAX=300
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
