# ResolverAI Environment Configuration
# Copy to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://resolver:resolver@localhost:5432/resolverai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI Mode ---
# Options: DETERMINISTIC, ENABLED
AI_MODE=DETERMINISTIC

# --- Razorpay Integration ---
# Options: SYNTHETIC, TEST, LIVE
RAZORPAY_MODE=SYNTHETIC
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- System ---
MAX_RETRIES=2
CHAOS_SEED=42
LOG_LEVEL=INFO
